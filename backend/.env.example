# Local development: copy to .env. On Railway set these as service variables instead (never commit .env).

SECRET_KEY=change-me
# Leave DATABASE_URL and REDIS_URL empty locally: SQLite is used and jobs run inline.
DATABASE_URL=
REDIS_URL=

# Railway only
ALLOWED_HOSTS=your-service.up.railway.app
CSRF_TRUSTED_ORIGINS=https://your-service.up.railway.app
ADMIN_URL=admin/

# Platform sync switches: on only with the client's written approval for that platform
SYNC_ENABLED_MOTORWAY=false
SYNC_ENABLED_CARWOW=false
SYNC_ENABLED_BCA=false
SYNC_ENABLED_MANHEIM=false
SYNC_DELAY_MS=4000

# Shared secret for POST /api/alerts/inbound (the forwarded saved-search alert emails)
ALERT_INBOUND_TOKEN=

# Who is emailed when a platform stops a run
OPS_ALERT_EMAILS=
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Chatbot AI (OpenRouter). Leave empty to use rule-based matching only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Vector search (pgvector). Must produce 1536-dimension vectors, e.g. openai/text-embedding-3-small.
# Changing it means running `python manage.py embed_listings` again for every car.
OPENROUTER_EMBEDDING_MODEL=

# Codeweavers Showroom login used to get finance quotes. Give the Hub its own Showroom user:
# Codeweavers allows one session per login, so signing in signs out anyone else using it.
CODEWEAVERS_LOGIN_URL=https://identity.codeweavers.app/en-gb/codeweavers/<dealer>/identity/app/showroom/login
CODEWEAVERS_USERNAME=
CODEWEAVERS_PASSWORD=

# Photo and quote document storage. Cloudinary: copy "API environment variable" from its dashboard
# (cloudinary://<api key>:<api secret>@<cloud name>). When set, it is used instead of the bucket below.
CLOUDINARY_URL=

# Photo storage (S3-compatible bucket). Empty = local media/ folder.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_KEY=
S3_SECRET=
# Only if the bucket host needs it: virtual or path
S3_ADDRESSING_STYLE=
