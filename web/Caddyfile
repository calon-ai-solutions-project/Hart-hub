# Serves the built React app and passes /api and /media to the backend over Railway's private
# network. One public origin, so the session cookie and CSRF token work without CORS.
{
	admin off
	auto_https off
	servers {
		# this container is only reachable through Railway's edge, which sets the forwarded headers
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

:{$PORT:8080} {
	encode zstd gzip

	@backend path /api/* /media/*
	handle @backend {
		reverse_proxy {$BACKEND_URL} {
			# Railway's edge is always https; the backend redirects anything it believes is http
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
